{
  "provider": "jina",
  "name": "Jina Reader",
  "docs": "https://jina.ai/reader/",
  "auth": { "type": "header", "name": "Authorization", "template": "Bearer {key}", "secret": "JINA_API_KEY", "optional": true },
  "headers": { "Accept": "application/json" },
  "endpoints": [
    {
      "id": "jina.read",
      "capability": "web.scrape",
      "summary": "Any URL as clean Markdown for an LLM",
      "method": "GET",
      "url": "https://r.jina.ai/{url}",
      "params": { "url": { "required": true, "in": "path", "raw": true } },
      "price_usd": 0,
      "hit": "data.content",
      "example": { "url": "https://example.com" }
    }
  ]
}
