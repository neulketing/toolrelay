{
  "provider": "typesafe",
  "name": "TypeSafe Jev",
  "docs": "https://docs.typesafe.ai",
  "auth": {
    "type": "header",
    "name": "Authorization",
    "template": "Bearer {key}",
    "secret": "TYPESAFE_API_KEY"
  },
  "endpoints": [
    {
      "id": "typesafe.jev.decide",
      "capability": "ai.judge",
      "summary": "Ask typed questions about a piece of text and get probabilities back: pick a label, answer yes/no, or place it on a scale",
      "method": "POST",
      "url": "https://api.typesafe.ai/v1/systemone",
      "params": {
        "state": {
          "required": true,
          "in": "body"
        },
        "questions": {
          "required": true,
          "in": "body"
        },
        "model": {
          "in": "body",
          "default": "jev-latest"
        }
      },
      "price_usd": 0.0005,
      "cost": {
        "path": "usage.input_tokens",
        "usd_per_unit": 4.2e-08
      },
      "hit": "answers",
      "example": {
        "state": "<review>Arrived two days late but the jacket fits perfectly.</review>",
        "questions": {
          "happy": {
            "type": "noul",
            "instructions": "Is the customer in <review> satisfied with the product overall?",
            "criteria": {
              "true": "satisfied",
              "false": "not satisfied"
            }
          }
        }
      },
      "bill": "call"
    }
  ]
}
